# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Google Sheets CSV fallback URL (File > Publish to Web > CSV format)
# Used as the public leaderboard fallback when Supabase is unreachable
VITE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv

# Admin login bypass for development (optional)
# Set these to enable simple dev-mode login without Supabase
VITE_DEV_ADMIN_EMAIL=admin@thrust5.in
VITE_DEV_ADMIN_PASSWORD=admin
